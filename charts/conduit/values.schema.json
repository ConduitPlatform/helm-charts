{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "kubeVersionOverride": { "type": "string" },
    "global": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "image": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "repository": { "type": "string" },
            "tag": { "type": "string" },
            "digest": { "type": "string" },
            "imagePullPolicy": { "type": "string" }
          }
        },
        "secret": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "existingSecret": { "type": "string" },
            "MASTER_KEY": { "type": ["string", "null"] },
            "GRPC_KEY": { "type": ["string", "null"] },
            "grpc_enable": { "type": "boolean" }
          }
        }
      }
    },
    "securityContext": { "type": "object", "additionalProperties": true },
    "podSecurityContext": { "type": "object", "additionalProperties": true },
    "redis": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "image": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "name": { "type": "string" },
            "tag": { "type": "string" },
            "digest": { "type": "string" }
          }
        },
        "strategy": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "type": { "type": "string" }
          }
        }
      }
    },
    "mongodb": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "persistence": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean" },
            "claimName": { "type": "string" },
            "size": { "type": "string" }
          }
        }
      }
    },
    "externalRedis": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "host": { "type": "string" },
        "password": { "type": "string" },
        "port": { "type": ["integer", "string"] },
        "existingSecret": { "type": "string" }
      }
    },
    "hpa": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer" },
        "maxReplicas": { "type": "integer" }
      }
    },
    "pdb": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "loki": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "setup": { "type": "boolean" }
      }
    },
    "prometheus": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "setup": { "type": "boolean" }
      }
    }
  }
}
